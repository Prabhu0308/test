






































































import { getAuth } from 'firebase/auth';
import { collection, getDocs } from 'firebase/firestore';
import { useEffect, useState } from 'react';
import { ActivityIndicator, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { db } from '../firebase/config';

function getStatus(item: any) {
  if (!item.resultChecked) return { label: '⏳ Pending', style: 'pending' };
  if (Number(item.pointsEarned || 0) > 0) return { label: '✅ Correct', style: 'correct' };
  return { label: '❌ Wrong', style: 'wrong' };
}

export default function PredictionHistoryScreen() {
  const [predictions, setPredictions] = useState<any[]>([]);
  const [filter, setFilter] = useState('all');
  const [loading, setLoading] = useState(true);

  async function loadPredictions() {
    try {
      setLoading(true);
      const user = getAuth().currentUser;
      const snap = await getDocs(collection(db, 'predictions'));

      const list = snap.docs
        .map((doc) => ({
          id: doc.id,
          ...doc.data(),
        }))
        .filter((item: any) => {
          if (!user) return false;
          return item.userId === user.uid || item.userEmail === user.email;
        })
        .sort((a: any, b: any) => Number(b.createdAt || 0) - Number(a.createdAt || 0));

      setPredictions(list);
    } catch (error) {
      console.log(error);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadPredictions();
  }, []);

  const checked = predictions.filter((p: any) => p.resultChecked);
  const correct = checked.filter((p: any) => Number(p.pointsEarned || 0) > 0);
  const totalPoints = predictions.reduce((sum, p: any) => sum + Number(p.pointsEarned || 0), 0);
  

const accuracy = checked.length === 0 ? 0 : Math.round((correct.length / checked.length) * 100);
  const pending = predictions.filter((p: any) => !p.resultChecked);
  const filteredPredictions = predictions.filter((item: any) => {
    if (filter === 'all') return true;
    if (filter === 'pending') return !item.resultChecked;
    if (filter === 'correct') return item.resultChecked && Number(item.pointsEarned || 0) > 0;
    if (filter === 'wrong') return item.resultChecked && Number(item.pointsEarned || 0) === 0;
    return true;
  });

  if (loading) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color="#FFD166" />
        <Text style={styles.loadingText}>Loading predictions...</Text>
      </View>
    );
  }

  return (
    <ScrollView style={styles.container}>
      <Text style={styles.title}>📊 Prediction History</Text>
      <Text style={styles.subtitle}>Track your picks, points, and accuracy</Text>

      <View style={styles.statsCard}>
        <View style={styles.statBox}>
          <Text style={styles.statNumber}>{predictions.length}</Text>
          <Text style={styles.statLabel}>Total</Text>
        </View>

        <View style={styles.statBox}>
          <Text style={styles.statNumber}>{accuracy}%</Text>
          <Text style={styles.statLabel}>Accuracy</Text>
        </View>

        <View style={styles.statBox}>
          <Text style={styles.statNumber}>{totalPoints}</Text>
          <Text style={styles.statLabel}>Points</Text>
        </View>
      </View>

      <View style={styles.filterRow}>
        {[
          { key: 'all', label: 'All' },
          { key: 'pending', label: 'Pending' },
          { key: 'correct', label: 'Correct' },
          { key: 'wrong', label: 'Wrong' },
        ].map((item) => (
          <Pressable
            key={item.key}
            style={[styles.filterButton, filter === item.key && styles.activeFilter]}
            onPress={() => setFilter(item.key)}
          >
            <Text style={[styles.filterText, filter === item.key && styles.activeFilterText]}>
              {item.label}
            </Text>
          </Pressable>
        ))}
      </View>

      {filteredPredictions.length === 0 ? (
        <Text style={styles.empty}>No predictions found.</Text>
      ) : (
        filteredPredictions.map((item) => {
          const status = getStatus(item);

          return (
            <View key={item.id} style={styles.card}>
              <View style={styles.cardHeader}>
                <Text style={styles.match}>{item.match || 'Unknown Match'}</Text>
                <Text
                  style={[
                    styles.statusBadge,
                    status.style === 'pending' && styles.pendingBadge,
                    status.style === 'correct' && styles.correctBadge,
                    status.style === 'wrong' && styles.wrongBadge,
                  ]}
                >
                  {status.label}
                </Text>
              </View>

              <Text style={styles.detail}>🏆 Your Pick: {item.winner || 'N/A'}</Text>
              <Text style={styles.detail}>🎯 Score Prediction: {item.scorePrediction || 'N/A'}</Text>
              <Text style={styles.detail}>🏟️ League: {item.league || 'Soccer'}</Text>

              {item.comment && item.comment !== 'No comment' ? (
                <Text style={styles.comment}>💬 “{item.comment}”</Text>
              ) : null}

              <View style={styles.pointsRow}>
                <Text style={styles.points}>🏅 +{Number(item.pointsEarned || 0)} pts</Text>
                <Text style={styles.date}>
                  {item.createdAt ? new Date(item.createdAt).toLocaleDateString() : ''}
                </Text>
              </View>
            </View>
          );
        })
      )}

      <Pressable style={styles.refresh} onPress={loadPredictions}>
        <Text style={styles.refreshText}>Refresh History</Text>
      </Pressable>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#07111F', padding: 20, paddingTop: 60 },
  loading: { flex: 1, backgroundColor: '#07111F', justifyContent: 'center', alignItems: 'center' },
  loadingText: { color: 'white', marginTop: 12 },
  title: { color: 'white', fontSize: 32, fontWeight: 'bold', marginBottom: 6 },
  subtitle: { color: '#A7B0C0', fontSize: 16, marginBottom: 18 },
  statsCard: {
    backgroundColor: '#123C69',
    padding: 16,
    borderRadius: 18,
    marginBottom: 18,
    flexDirection: 'row',
    justifyContent: 'space-between',
  },
  statBox: { alignItems: 'center', flex: 1 },
  statNumber: { color: '#FFD166', fontSize: 26, fontWeight: 'bold' },
  statLabel: { color: 'white', marginTop: 4, fontWeight: 'bold' },
  filterRow: { flexDirection: 'row', flexWrap: 'wrap', gap: 10, marginBottom: 18 },
  filterButton: {
    backgroundColor: '#111C2E',
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 20,
    borderWidth: 1,
    borderColor: '#22314A',
  },
  activeFilter: { backgroundColor: '#FFD166', borderColor: '#FFD166' },
  filterText: { color: 'white', fontWeight: 'bold' },
  activeFilterText: { color: '#07111F' },
  card: { backgroundColor: '#111C2E', padding: 16, borderRadius: 18, marginBottom: 14 },
  cardHeader: { flexDirection: 'row', justifyContent: 'space-between', gap: 10, marginBottom: 12 },
  match: { color: 'white', fontSize: 18, fontWeight: 'bold', flex: 1 },
  statusBadge: { overflow: 'hidden', paddingVertical: 6, paddingHorizontal: 10, borderRadius: 14, fontWeight: 'bold' },
  pendingBadge: { color: '#07111F', backgroundColor: '#FFD166' },
  correctBadge: { color: 'white', backgroundColor: '#2E7D32' },
  wrongBadge: { color: 'white', backgroundColor: '#C62828' },
  detail: { color: '#A7B0C0', marginBottom: 6, fontSize: 15 },
  comment: { color: 'white', backgroundColor: '#07111F', padding: 12, borderRadius: 12, marginTop: 8, marginBottom: 8 },
  pointsRow: { flexDirection: 'row', justifyContent: 'space-between', marginTop: 10 },
  points: { color: '#FFD166', fontWeight: 'bold' },
  date: { color: '#8FA3B8' },
  refresh: { backgroundColor: '#FFD166', padding: 14, borderRadius: 14, marginTop: 10, marginBottom: 40 },
  refreshText: { color: '#07111F', textAlign: 'center', fontWeight: 'bold' },
  empty: { color: '#8FA3B8', fontSize: 16, marginBottom: 20 },
});

