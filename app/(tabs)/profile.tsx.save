
import React, { useEffect, useState } from 'react';
import { View, Text, StyleSheet, Pressable, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { getAuth } from 'firebase/auth';

export default function ProfileScreen() {
  const [email, setEmail] = useState<string>('Guest User');

  useEffect(() => {
    const auth = getAuth();
    const userEmail = auth.currentUser?.email;

    if (userEmail) {
      setEmail(userEmail);
    }
  }, []);

  return (
    <ScrollView style={styles.container} showsVerticalScrollIndicator={false}>
      <Text style={styles.title}>👤 Profile</Text>
      <Text style={styles.subtitle}>Welcome to Soccer Daily</Text>

      <View style={styles.userCard}>
        <Text style={styles.userLabel}>Signed in as</Text>
        <Text style={styles.userEmail}>{email}</Text>
      </View>

      <Pressable style={styles.card} onPress={() => router.push('/leaderboard')}>
        <Text style={styles.cardTitle}>🏆 Leaderboard</Text>
        <Text style={styles.cardText}>See top fans, points, and rankings</Text>
      </Pressable>

      <Pressable style={styles.card} onPress={() => router.push('/prediction-history')}>
        <Text style={styles.cardTitle}>📊 Prediction History</Text>
        <Text style={styles.cardText}>View your picks, points, and accuracy</Text>
      </Pressable>

      <Pressable style={styles.card} onPress={() => router.push('/notifications')}>
        <Text style={styles.cardTitle}>🔔 Notification Center</Text>
        <Text style={styles.cardText}>See prediction results, match alerts, and app updates</Text>
      </Pressable>

      <Pressable style={styles.card} onPress={() => router.push('/fan-wall')}>
        <Text style={styles.cardTitle}>💬 Fan Wall</Text>
        <Text style={styles.cardText}>Post, like, comment, edit, and delete fan posts</Text>
      </Pressable>

      <Pressable style={styles.card} onPress={() => router.push('/login')}>
        <Text style={styles.cardTitle}>🔐 Login</Text>
        <Text style={styles.cardText}>Sign in or manage your account</Text>
      </Pressable>

      <Pressable style={styles.card} onPress={() => router.push('/settings')}>
        <Text style={styles.cardTitle}>⚙️ Settings</Text>
        <Text style={styles.cardText}>Language, alerts, and app preferences</Text>
      </Pressable>

      <View style={styles.footerSpace} />
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#07111F',
    padding: 20,
    paddingTop: 60,
  },
  title: {
    color: 'white',
    fontSize: 34,
    fontWeight: 'bold',
    marginBottom: 8,
  },
  subtitle: {
    color: '#A7B0C0',
    fontSize: 16,
    marginBottom: 18,
  },
  userCard: {
    backgroundColor: '#111C2E',
    padding: 18,
    borderRadius: 18,
    marginBottom: 18,
    borderLeftWidth: 4,
    borderLeftColor: '#FFD166',
  },
  userLabel: {
    color: '#A7B0C0',
    fontSize: 14,
    marginBottom: 6,
  },
  userEmail: {
    color: 'white',
    fontSize: 16,
    fontWeight: 'bold',
  },
  card: {
    backgroundColor: '#111C2E',
    padding: 18,
    borderRadius: 18,
    marginBottom: 14,
  },
  cardTitle: {
    color: 'white',
    fontSize: 20,
    fontWeight: 'bold',
    marginBottom: 8,
  },
  cardText: {
    color: '#A7B0C0',
    fontSize: 15,
    lineHeight: 21,
  },
  footerSpace: {
    height: 50,
  },
});
